.vscode/*
!.vscode/extensions.json
node_modules/
backend/app/frontend/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local secrets — never commit. Copy .env.example to .env and fill in.
.env

# Design exports are 1MB bundled-JS artifacts, re-importable from Claude Design.
# The authoritative source is the .dc.html in the design project, not these bundles.
resources/*.html

# Transient artifact: scripts/generate-client.sh writes it here before moving it to frontend/
openapi.json

# Backfill dumps from scripts/dump-backfill.sh. Deliberately not committed:
# ~420 KB per revision, and stale the moment the current season re-ingests.
# Generate on demand — see deployment-snapcount.md.
*.sql.gz
